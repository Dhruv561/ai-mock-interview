# Extension build-time configuration (Vite `import.meta.env`, VITE_-prefixed
# vars only — see https://vite.dev/guide/env-and-mode). Copy to .env if you
# need to point the extension at a non-default backend.

# WebSocket URL the content script connects to (networking/interviewSocket.ts).
# Defaults to ws://localhost:8000/ws/interview if unset.
VITE_BACKEND_WS_URL=ws://localhost:8000/ws/interview
