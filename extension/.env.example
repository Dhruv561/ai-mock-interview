# Extension build-time configuration (Vite `import.meta.env`, VITE_-prefixed
# vars only — see https://vite.dev/guide/env-and-mode). Copy to .env if you
# need to point the extension at a non-default backend.

# WebSocket URL the content script connects to (networking/interviewSocket.ts).
# Defaults to ws://127.0.0.1:8000/ws/interview if unset. Only used by the
# deprecated legacy pipeline (VITE_USE_LEGACY_PIPELINE=true, below) — the
# default Convai pipeline doesn't use this WS at all.
#
# Use 127.0.0.1 rather than "localhost": on macOS "localhost" resolves to
# IPv6 ::1 first, but `uvicorn --host 0.0.0.0` binds IPv4 only, so Chrome's
# WebSocket connects to [::1]:8000, finds nothing, and fails to connect.
# (curl masks this — it falls back to IPv4 by itself.)
VITE_BACKEND_WS_URL=ws://127.0.0.1:8000/ws/interview

# Judges-only auth (Feature 17): sent as ?token= on the WS connect URL (legacy
# pipeline) or the /api/convai/* REST calls (default pipeline), checked
# against the deployed backend's SESSION_SHARED_SECRETS. Leave unset for
# local dev — the backend has no secrets configured either, so this is a
# no-op. Only needed when building a demo bundle to hand to judges against a
# hosted backend that has SESSION_SHARED_SECRETS set.
VITE_BACKEND_WS_TOKEN=

# --- Default interviewer pipeline: ElevenLabs Conversational AI ---
# One hosted ElevenLabs agent handles STT+LLM+TTS+turn-taking itself — see
# architecture.md's "Default interviewer pipeline" addendum and
# progress.md's "Spike" section for the full decision record (including the
# known regressions this accepted vs. the pipeline below: no tiered hints,
# no live stage tracking, thinner review evidence).

# Base HTTP (not WS) URL for the signed-url/review REST endpoints
# (backend/app/api/convai.py). Defaults to http://127.0.0.1:8000 if unset.
VITE_BACKEND_HTTP_URL=

# --- Deprecated fallback: Deepgram STT + Claude controller + ElevenLabs TTS ---
# Set to "true" to use this pipeline instead of the Convai one above — kept
# working and tested, not deleted, in case the default doesn't hold up.
VITE_USE_LEGACY_PIPELINE=
