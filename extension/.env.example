# Extension build-time configuration (Vite `import.meta.env`, VITE_-prefixed
# vars only — see https://vite.dev/guide/env-and-mode). Copy to .env if you
# need to point the extension at a non-default backend.

# WebSocket URL the content script connects to (networking/interviewSocket.ts).
# Defaults to ws://127.0.0.1:8000/ws/interview if unset.
#
# Use 127.0.0.1 rather than "localhost": on macOS "localhost" resolves to
# IPv6 ::1 first, but `uvicorn --host 0.0.0.0` binds IPv4 only, so Chrome's
# WebSocket connects to [::1]:8000, finds nothing, and fails to connect.
# (curl masks this — it falls back to IPv4 by itself.)
VITE_BACKEND_WS_URL=ws://127.0.0.1:8000/ws/interview

# Judges-only auth (Feature 17): sent as ?token= on the WS connect URL,
# checked against the deployed backend's SESSION_SHARED_SECRETS. Leave unset
# for local dev — the backend has no secrets configured either, so this is
# a no-op. Only needed when building a demo bundle to hand to judges against
# a hosted backend that has SESSION_SHARED_SECRETS set.
VITE_BACKEND_WS_TOKEN=

# --- ElevenLabs Conversational AI spike (spikes/elevenlabs-convai/) ---
# Not part of the real pipeline above. Set to "true" to swap the panel's
# default Deepgram/Claude-controller/ElevenLabs-TTS pipeline for the
# ElevenLabs Conversational AI one being evaluated in that spike — see
# progress.md's "Spike" section. Leave unset for the real app.
VITE_USE_ELEVENLABS_CONVAI=

# Base HTTP (not WS) URL for the spike's signed-url/review REST endpoints
# (backend/app/api/convai.py). Defaults to http://127.0.0.1:8000 if unset.
VITE_BACKEND_HTTP_URL=
