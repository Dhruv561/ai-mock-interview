# Backend config template. This file (.env.example) is committed and NOT
# gitignored, so never put real keys here. Copy it to backend/.env, which
# is gitignored, and put real keys there instead.
#
# NOTE: this file must live in backend/, not the repo root. The backend is
# started with `cd backend`, and pydantic-settings resolves env_file=".env"
# against the working directory, so a root-level .env is silently ignored.

# Must be false for ANY real provider to be used — it overrides every key.
# Each provider still falls back to its mock independently when its own key
# is missing, so setting only ANTHROPIC_API_KEY below gets you a real
# interviewer LLM while everything else stays mocked. You don't have to set
# every key at once.
USE_MOCK_PROVIDERS=false

ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_CONVAI_AGENT_ID=