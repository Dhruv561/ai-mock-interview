# Backend environment configuration.
# Copy to .env and fill in as each provider integration stage is reached.
# See architecture.md §U for what each variable is for and §S for how the app
# runs with none of these set (USE_MOCK_PROVIDERS=true).

# --- LLM (interviewer + evaluator agents) ---
ANTHROPIC_API_KEY=

# --- Speech-to-text (Deepgram, streaming) ---
DEEPGRAM_API_KEY=

# --- Text-to-speech (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Gemini Live API (spike — alternative realtime pipeline) ---
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Persistence (optional; falls back to in-memory when unset) ---
# A direct Postgres connection string — a Supabase-hosted Postgres works
# here too (it's asyncpg against the connection string, not the Supabase
# client SDK, so there's no separate Supabase URL/service-role key).
DATABASE_URL=

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed WebSocket/CORS origins.
ALLOWED_ORIGINS=chrome-extension://<dev-extension-id>,https://leetcode.com

# --- App behaviour ---
APP_ENV=local
# Forces mock LLM/STT/TTS providers even if keys above are present.
# Keep true for local development; set false only once you want to hit real providers.
USE_MOCK_PROVIDERS=true

# --- Deployment-only safeguards (Feature 19) ---
# All three default to off/unlimited — irrelevant for local dev. Set these
# once the backend is reachable from somewhere other than your own machine.
# See architecture.md §U and DEPLOY.md.

# Comma-separated join codes. A WebSocket connection must supply one as
# ?token= or the handshake is rejected. Empty = no auth check at all.
SESSION_SHARED_SECRETS=

# Hard cap on concurrent live interview sessions. 0 = unlimited. This (not a
# request-rate limiter) is what actually bounds worst-case provider spend,
# since cost scales with concurrent sessions x duration.
MAX_CONCURRENT_SESSIONS=0

# Force-ends any session running longer than this many seconds, regardless
# of client behaviour. 0 = unlimited.
SESSION_MAX_DURATION_SECONDS=0
